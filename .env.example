# -------------------------------
# Application Environment
# -------------------------------

# Server Environment (e.g. development, production, staging, test)
NODE_ENV="development"

# Server Port
PORT=5000


# -------------------------------
# Database
# -------------------------------

# PostgreSQL connection URL
DATABASE_URL="postgresql://username:password@host:port/database_name"


# -------------------------------
# Client
# -------------------------------

# Frontend origin used for CORS. If there's no separate frontend, set this to the same value as the server URL.
CLIENT_URL="http://localhost:5000"


# -------------------------------
# Redis
# -------------------------------

# Redis connection details
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Optional password (leave blank if not used)
REDIS_PASS=""


# -------------------------------
# Security
# -------------------------------

# CSRF secret for token hashing
CSRF_SECRET="your_csrf_secret_here"

# JWT secrets and expiration times
JWT_ACCESS_SECRET="your_access_secret_here"
JWT_REFRESH_SECRET="your_refresh_secret_here"

# Expiration formats: 1m (minutes), 1d (days), 1h (hour)
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"


# -------------------------------
# Email (SMTP)
# -------------------------------

# SMTP server configuration
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your_smtp_username"
SMTP_PASS="your_smtp_password"


# -------------------------------
# Setup
# -------------------------------
# 1. Install dependencies:
#    pnpm install
#
# 2. Run database migrations:
#    pnpm prisma:migrate:prod
#
# 3. Generate Prisma Client:
#    pnpm prisma:generate
#
# 4. Start development server:
#    pnpm start:dev
#
# 5. Build for production:
#    pnpm build
#
# 6. Start production server:
#    pnpm start:prod