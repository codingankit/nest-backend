{
  "name": "nest-backend",
  "version": "1.0.0",
  "private": true,
  "author": "Ankit Dutta",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate --config=src/infra/prisma/schema/prisma.config.ts --schema=src/infra/prisma/schema/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --config=src/infra/prisma/schema/prisma.config.ts --schema=src/infra/prisma/schema/schema.prisma",
    "prisma:migrate:prod": "prisma migrate deploy --config=src/infra/prisma/schema/prisma.config.ts --schema=src/infra/prisma/schema/schema.prisma",
    "prisma:migrate:status": "prisma migrate status --config=src/infra/prisma/schema/prisma.config.ts --schema=src/infra/prisma/schema/schema.prisma",
    "prisma:migrate:reset": "prisma migrate reset --config=src/infra/prisma/schema/prisma.config.ts --schema=src/infra/prisma/schema/schema.prisma",
    "prisma:db:push": "prisma db push --config=src/infra/prisma/schema/prisma.config.ts --schema=src/infra/prisma/schema/schema.prisma",
    "prisma:studio": "prisma studio --config=src/infra/prisma/schema/prisma.config.ts",
    "prisma:format": "prisma format --config=src/infra/prisma/schema/prisma.config.ts --schema=src/infra/prisma/schema/schema.prisma",
    "prisma:validate": "prisma validate --config=src/infra/prisma/schema/prisma.config.ts --schema=src/infra/prisma/schema/schema.prisma",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@anatine/zod-nestjs": "^2.0.12",
    "@nestjs/common": "^11.2.6",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.43.1",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.0.3",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "ms": "^2.1.3",
    "multer": "^2.4.0",
    "nodemailer": "^7.0.13",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "slugify": "^1.6.9",
    "uuid": "^13.0.2",
    "uuidv7": "^1.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.6",
    "@prisma/config": "^7.10.0",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.16.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^29.5.14",
    "@types/ms": "^2.1.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^6.4.24",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
  "engines": {
    "node": ">=20"
  }
}
